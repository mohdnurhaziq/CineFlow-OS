# ─── CineFlow OS — STAGING settings ───────────────────────────────────────────
# Copy to <CineFlow>/staging/.env on the 24/7 PC and fill in the blanks.
# Staging is the test copy: demo data, a test inbox, test payments, only you can open it.
# Never put real client data here. Never commit the real .env.

# Which copy this is. Keep these four as they are.
COMPOSE_PROJECT_NAME=cineflow-staging
COMPOSE_PROFILES=mail,domain
APP_ENV=staging
DEPLOY_BRANCH=main

# Where the app listens on the 24/7 PC (the tunnel is how people reach it)
APP_BIND=127.0.0.1
APP_PORT=3100
# Test inbox: open http://localhost:8125 on the 24/7 PC to read staging's emails
MAILPIT_PORT=8125
MAILPIT_SMTP_PORT=1125

# Staging's address. Fixed into the build: change it, then deploy again.
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_DOMAIN=staging.example.com

# Signing secret for sign-ins. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different one from production.
AUTH_SECRET=

# Cloudflare tunnel token for staging.<domain> (Zero Trust → Networks → Tunnels)
TUNNEL_TOKEN=

# Every email goes to the test inbox above, never to real people
SMTP_HOST=mailpit
SMTP_PORT=1025

# Test payments only
ALLOW_SIMULATED_CARD_PAYMENTS=true
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

# Fill a new staging database with demo data
SEED_ON_FIRST_RUN=true
