# ─── CineFlow OS — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values before running the app.
# Never commit the actual .env file to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development / single-server deployment)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production recommended)
# DATABASE_URL="postgresql://user:password@host:5432/cineflow_prod?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# Minimum 32 random characters. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# ─── App Domain ───────────────────────────────────────────────────────────────
# The root domain for the platform (used for subdomain routing)
NEXT_PUBLIC_APP_DOMAIN="cineflow.app"

# The full base URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="https://cineflow.app"

# ─── Email Transport (Resend) ─────────────────────────────────────────────────
# Required to send transactional emails (booking confirmations, payment alerts).
# Get your key at https://resend.com — leave empty to disable sending.
RESEND_API_KEY=""

# From address used for outbound transactional emails
RESEND_FROM_EMAIL="CineFlow OS <noreply@cineflow.app>"

# ─── Node Environment ─────────────────────────────────────────────────────────
# "development" | "test" | "production"
NODE_ENV="production"
