# ─── CineFlow OS — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values before running the app.
# Never commit the actual .env file to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development / single-server deployment)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production recommended)
# DATABASE_URL="postgresql://user:password@host:5432/cineflow_prod?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# Minimum 32 random characters. Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# ─── App Domain ───────────────────────────────────────────────────────────────
# The root domain for the platform (used for subdomain routing)
NEXT_PUBLIC_APP_DOMAIN="cineflow.app"

# The full base URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="https://cineflow.app"

# ─── Email Transport ──────────────────────────────────────────────────────────
# Transactional emails (booking confirmations, invites, invoices) go out over SMTP when
# SMTP_HOST, SMTP_USER and SMTP_PASS are set; otherwise through Resend when
# RESEND_API_KEY is set; otherwise they are skipped.

# Development: Mailpit (started by docker-compose) catches every email in a web inbox at
# http://localhost:8025 and never delivers to real inboxes. Leave SMTP_USER/SMTP_PASS empty:
#   SMTP_HOST="mailpit"   (use "localhost" when running `pnpm dev` outside Docker)
#   SMTP_PORT="1025"

# Option A: SMTP, e.g. Gmail (no domain needed; about 500 emails a day).
# SMTP_PASS must be a Google App Password, not your normal password:
#   Google Account → Security → 2-Step Verification (turn on) → App passwords.
# Emails arrive from SMTP_USER with the studio's name as the sender name.
SMTP_HOST=""            # smtp.gmail.com
SMTP_PORT="465"         # 465 (TLS) or 587 (STARTTLS)
SMTP_USER=""            # you@gmail.com
SMTP_PASS=""            # 16-character app password
# SMTP_SECURE="true"    # optional; defaults to true on port 465
# SMTP_FROM_ADDRESS=""  # optional sender address; defaults to SMTP_USER

# Option B: Resend (needs a verified domain to email anyone but yourself).
# Get your key at https://resend.com — leave empty to disable.
RESEND_API_KEY=""

# From address used for outbound transactional emails
RESEND_FROM_EMAIL="CineFlow OS <noreply@cineflow.app>"

# ─── Node Environment ─────────────────────────────────────────────────────────
# "development" | "test" | "production"
NODE_ENV="production"

# Payments (Toyyibpay). Each studio enters its own secret key in Admin > Settings.
# TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com   # sandbox; omit for production
# Dev/test only: allow the fake instant card flow when a studio has no gateway. Never enable in production.
# ALLOW_SIMULATED_CARD_PAYMENTS=true
