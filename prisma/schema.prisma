datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. WORKSPACE & MULTI-TENANCY
// ==============================================================================

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  customDomain       String?             @unique
  discipline         String              @default("HYBRID") // PHOTOGRAPHY, VIDEOGRAPHY, HYBRID
  tagline            String?
  bio                String?
  logoUrl            String?
  brandColor         String?             @default("#f59e0b")
  currency           String              @default("USD")
  qrCodeUrl          String?             // Studio payment QR code image asset
  bankDetails        String?             // Bank name, account number, account holder
  releaseFilesBeforePayment Boolean      @default(false) // false: clients see watermarked previews until the balance is paid; true: full-resolution files right after upload
  offersPrints       Boolean             @default(true) // false: the studio sells no framed prints, so clients see no Wall Art, print ordering or included prints (only on a plan with wall art)
  toyyibpaySecretEnc    String?          // AES-GCM encrypted Toyyibpay userSecretKey (never stored in plaintext)
  toyyibpayCategoryCode String?          // Toyyibpay category the studio's bills are created under
  invoiceSeq         Int                 @default(0) // Last invoice number used in invoiceSeqYear (INV-<year>-<seq>)
  invoiceSeqYear     Int?                // Year invoiceSeq counts in; a new year starts again from 1
  subscriptionTier  String              @default("PRO") // STARTER, PRO, STUDIO_UNLIMITED
  subscriptionStatus String              @default("ACTIVE") // ACTIVE, TRIALING, CANCELLED
  trialEndsAt        DateTime?           // End of the free trial (sign-up + 14 days)
  paidUntil          DateTime?           // Last day the paid plan covers (Malaysia time); set by recorded payments
  pausedAt           DateTime?           // Set when the studio is paused (by lateness or by hand)
  pauseReason        String?             // OVERDUE or MANUAL
  lastPlanReminder   String?             // Key of the last plan reminder email sent, e.g. "due:2026-12-01"
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  users                  User[]
  teamRoles              TeamRole[]
  proposals              Proposal[]
  proposalAddOnTemplates ProposalAddOnTemplate[]
  invoices               MilestoneInvoice[]
  projects               Project[]
  inventoryItems         InventoryItem[]
  kitBundles             KitBundle[]
  frameDesigns           FrameDesign[]
  printSizes             PrintSize[]
  matBoardPrice          Float               @default(25)
  shippingZones          ShippingZone[]
  bookingIncludedPrints  BookingIncludedPrint[]
  printOrders            PrintOrder[]
  clientBookings         ClientBooking[]
  bookingSlots           BookingSlot[]
  servicePackages        ServicePackage[]
  campaignCategories     CampaignCategory[]
  showcaseItems          ShowcaseItem[]
  platformPayments       PlatformPayment[]
}

/// A payment the platform owner recorded for a studio's plan (collected by hand).
model PlatformPayment {
  id           String   @id @default(cuid())
  tenantId     String
  amount       Float
  method       String   // BANK_TRANSFER, DUITNOW, CASH, OTHER
  reference    String?
  plan         String   // STARTER, PRO, STUDIO_UNLIMITED
  paidUntil    DateTime
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

model CampaignCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // e.g. "Convocation 2026", "Hari Raya Festive Special"
  slug        String   // e.g. "convocation", "hari-raya"
  badgeIcon   String?  // emoji or icon symbol e.g. "🎓", "🌙", "💍", "🎬"
  description String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  isProduction      Boolean  @default(false) @map("autoCreateProject") // true: bookings become Production projects; false: Session projects

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isActive, sortOrder])
}

model ProposalAddOnTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // e.g. "Drone 4K Aerial Coverage", "RAW Footage SSD Drive"
  description String
  price       Float
  unit        String   @default("fixed") // fixed, per_hour, per_day
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model BookingSlot {
  id              String         @id @default(cuid())
  tenantId        String
  category        String         @default("STUDIO_PORTRAIT")
  campaignTitle   String?
  date            DateTime
  startTime       String         // e.g. "10:00 AM"
  endTime         String         // e.g. "11:00 AM"
  status          String         @default("AVAILABLE") // AVAILABLE, HELD, PENDING_VERIFICATION, BOOKED, BLOCKED
  heldUntil       DateTime?      // 10-minute hold expiration
  heldBySessionId String?        // Client session holding slot
  price           Float          @default(0.0)
  depositRequired Float          @default(50.0)

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking         ClientBooking?

  @@index([tenantId])
  @@index([tenantId, date, status])
  @@index([tenantId, category])
  @@index([status, heldUntil])
}

model FrameDesign {
  id           String   @id @default(cuid())
  tenantId     String
  name         String   // e.g. "Matte Black Minimalist", "Warm Walnut Shadowbox"
  material     String   // Wood, Aluminum, Acrylic
  moldingWidth Float    // Border width in inches
  frameColor   String   // Color code / finish
  previewAsset String   // Texture / graphic preview URL
  priceOffset  Float    @default(0.0)
  isAvailable  Boolean  @default(true)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isAvailable])
}

model PrintSize {
  id           String   @id @default(cuid())
  tenantId     String
  code         String   // e.g. "8R", "12R", "16R", "20R"
  name         String   // e.g. "8R (8 x 10 in)"
  widthInches  Float
  heightInches Float
  basePrice    Float
  isAvailable  Boolean  @default(true)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ==============================================================================
// 2. USERS & ROLES
// ==============================================================================

/// One person's sign-in across studios. Exists only for an email that has been proven (a link we
/// emailed, or Google). Each studio keeps its own User for the person, pointing here.
model Login {
  id                 String   @id @default(cuid())
  email              String   @unique // lowercase
  passwordHash       String?  // none for a Google-only login
  googleSub          String?  @unique
  sessionsValidAfter DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
}

model User {
  id                 String              @id @default(cuid())
  tenantId           String?
  name               String
  email              String
  phone              String?
  role               String              @default("CLIENT") // SUPER_ADMIN, STUDIO_OWNER, PHOTOGRAPHER, VIDEOGRAPHER, CREW, CLIENT
  passwordHash       String?
  inviteToken        String?             @unique
  inviteTokenExpires DateTime?
  isQuickCreated     Boolean             @default(false)
  // Private notes the studio keeps about a client (preferences, reminders). Never shown to the client.
  staffNotes         String?
  // "Forgot password": SHA-256 of the one-time reset token (never the token itself) and when it expires.
  passwordResetToken   String?
  passwordResetExpires DateTime?
  // Sessions signed in before this time are no longer accepted (set when the password is reset).
  sessionsValidAfter   DateTime?
  // Last delivery address used for wall art print orders.
  shipRecipient        String?
  shipPhone            String?
  shipLine1            String?
  shipLine2            String?
  shipPostcode         String?
  shipCity             String?
  shipState            String?
  // Onboarding guide on the admin dashboard: set when the owner closes the setup checklist,
  // and when this user finishes or skips the dashboard tour. Null = not yet.
  onboardingChecklistDismissedAt DateTime?
  onboardingTourSeenAt           DateTime?
  // Team: the role this person holds, their own extra access on top of it (JSON), and when
  // the studio deactivated them (null = active). Deactivated people keep their past work.
  teamRoleId         String?
  // The person's one login (one email, one password or Google across studios). Null: a stand-alone account.
  loginId            String?
  login              Login?              @relation(fields: [loginId], references: [id], onDelete: SetNull)
  extraAccess        String?
  deactivatedAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamRole           TeamRole?           @relation(fields: [teamRoleId], references: [id], onDelete: SetNull)
  assignments        BookingAssignment[]
  clientBookings     ClientBooking[]
  clientProposals    Proposal[]          @relation("ClientProposals")
  studioProposals    Proposal[]          @relation("StudioProposals")
  clientProjects     Project[]           @relation("ClientProjects")
  studioProjects     Project[]           @relation("StudioProjects")
  invoices           MilestoneInvoice[]
  printOrders        PrintOrder[]        @relation("PrintOrderClient")

  // One account per email per studio, so the same person can be a client of several studios.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([loginId])
  @@index([role])
}

// ==============================================================================
// 3. PROPOSALS, ADD-ONS & MILESTONE BILLING
// ==============================================================================

model Proposal {
  id                   String              @id @default(cuid())
  tenantId             String
  proposalNumber       String              @unique
  clientId             String
  studioId             String
  title                String
  category             String              @default("COMMERCIAL")
  discipline           String              // PHOTOGRAPHY, VIDEOGRAPHY, HYBRID
  basePrice            Float
  totalPrice           Float
  depositPercentage    Float               @default(50.0)
  depositAmount        Float
  finalBalanceAmount   Float
  status               String              @default("SENT") // DRAFT (studio only), SENT, ACCEPTED, DECLINED
  contractTerms        String
  clientSignature      String?
  signedAt             DateTime?
  declinedAt           DateTime?
  declineReason        String?             // The client's reason for declining, if they gave one
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client               User                @relation("ClientProposals", fields: [clientId], references: [id])
  studio               User                @relation("StudioProposals", fields: [studioId], references: [id])
  addOns               ProposalAddOn[]
  invoices             MilestoneInvoice[]
  project              Project?

  @@index([tenantId])
  @@index([clientId])
  @@index([studioId])
  @@index([tenantId, status])
}

model ProposalAddOn {
  id          String   @id @default(cuid())
  proposalId  String
  name        String
  description String
  price       Float
  unit        String   @default("fixed") // fixed, per_hour, per_day
  quantity    Int      @default(1)
  isSelected  Boolean  @default(false)

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model MilestoneInvoice {
  id               String    @id @default(cuid())
  tenantId         String
  invoiceNumber    String    // Sequential per studio and year, e.g. INV-2026-0007
  proposalId       String?
  projectId        String?
  clientId         String
  milestoneType    String    // RETAINER_50, FINAL_BALANCE_50, PRINT_FRAME_ORDER, BOOKING_DEPOSIT, BOOKING_BALANCE, CUSTOM
  description      String?   // What a CUSTOM invoice is for (shown as its line item)
  amount           Float
  status           String    @default("PENDING") // PENDING, PENDING_VERIFICATION, PAID, OVERDUE
  paymentMethod    String?   // CARD, QR_CODE, CASH, BANK_TRANSFER
  paymentProofUrl  String?
  paymentReference String?
  verifiedBy       String?
  rejectedAt       DateTime? // When the studio last rejected a payment slip; the client has 24h to send a new one
  rejectionReason  String?   // Why, shown to the client
  dueDate          DateTime
  paidAt           DateTime?
  gatewayBillCode  String?   @unique // Toyyibpay BillCode for online (FPX/card) payments
  bookingId        String?   // The booking a BOOKING_DEPOSIT invoice pays for
  createdAt        DateTime  @default(now())

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal         Proposal? @relation(fields: [proposalId], references: [id])
  project          Project?  @relation(fields: [projectId], references: [id])
  client           User      @relation(fields: [clientId], references: [id])
  booking          ClientBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  printOrder       PrintOrder?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([proposalId])
  @@index([projectId])
  @@index([clientId])
  @@index([bookingId])
  @@index([tenantId, status])
  @@index([tenantId, milestoneType])
}

// ==============================================================================
// 4. PRODUCTION OPERATIONS & LOGISTICS
// ==============================================================================

model Project {
  id                 String              @id @default(cuid())
  tenantId           String
  projectNumber      String              @unique
  title              String
  category           String              @default("STUDIO_PORTRAIT")
  clientId           String
  studioLeadId       String
  discipline         String              // PHOTOGRAPHY, VIDEOGRAPHY, HYBRID
  proposalId         String?             @unique
  bookingId          String?             @unique
  status             String              @default("PRE_PRODUCTION") // PRE_PRODUCTION, PRODUCTION, POST_PRODUCTION, IN_REVIEW, DELIVERED
  kind               String              @default("PRODUCTION") // SESSION (quick shoot: files + payments) or PRODUCTION (full planning tools)
  shootDates         String?
  budget             Float
  isFinalBalancePaid Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             User                @relation("ClientProjects", fields: [clientId], references: [id])
  studioLead         User                @relation("StudioProjects", fields: [studioLeadId], references: [id])
  proposal           Proposal?           @relation(fields: [proposalId], references: [id])
  booking            ClientBooking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  callSheets         CallSheet[]
  shotItems          ShotItem[]
  digitalReleases    DigitalRelease[]
  deliverables       ClientDeliverable[]
  invoices           MilestoneInvoice[]
  reservations       EquipmentReservation[]
  printOrders        PrintOrder[]

  @@index([tenantId])
  @@index([clientId])
  @@index([studioLeadId])
  @@index([bookingId])
  @@index([tenantId, status])
  @@index([tenantId, kind])
}

model CallSheet {
  id                 String   @id @default(cuid())
  projectId          String
  title              String
  shootDate          DateTime
  generalCallTime    String   // e.g. "07:30 AM"
  locationName       String
  locationAddress    String
  locationPinUrl     String?
  parkingNotes       String?
  hospitalName       String?
  hospitalAddress    String?
  weatherSummary     String?
  temperature        String?
  sunriseTime        String?
  sunsetTime         String?
  goldenHourMorning  String?
  goldenHourEvening  String?
  notes              String?
  crewJson           String?  // JSON string array of crew roster & individual call times
  createdAt          DateTime @default(now())

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, shootDate])
}

model ShotItem {
  id                String   @id @default(cuid())
  projectId         String
  sceneNumber       String
  shotNumber        String
  framing           String
  cameraLens        String
  lightingSetup     String
  referenceImageUrl String?
  description       String
  status            String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([projectId, status])
}

model DigitalRelease {
  id               String   @id @default(cuid())
  projectId        String
  releaseType      String   // TALENT, LOCATION
  signerName       String
  signerEmail      String
  signerPhone      String?
  signerRole       String?
  termsContent     String
  signatureDataUrl String   // Base64 encoded signature image
  signedAt         DateTime @default(now())
  notes            String?
  collectedById    String?  // Signed-in user whose session submitted the release (staff or the project's client)
  collectedByName  String?  // Their name at the time, kept even if the account is later renamed or removed

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, releaseType])
}

// ==============================================================================
// 5. CLIENT DELIVERABLES VAULT
// ==============================================================================

model ClientDeliverable {
  id             String            @id @default(cuid())
  projectId      String
  title          String
  discipline     String
  versionTag     String            @default("v1.0")
  status         String            @default("READY")
  createdAt      DateTime          @default(now())

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items          DeliverableItem[]

  @@index([projectId])
}

model DeliverableItem {
  id             String            @id @default(cuid())
  deliverableId  String
  itemType       String            // PHOTO, VIDEO
  title          String
  previewUrl     String            // Watermarked preview or streaming link
  downloadUrl    String            // Unlocked high-res master download URL
  viewUrl        String?           // Private clean web-size copy, shown in the vault once files are released
  thumbnailUrl   String?
  resolution     String?
  duration       String?
  fileSize       String?
  isClientFav    Boolean           @default(false)
  clientNotes    String?

  deliverable    ClientDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@index([deliverableId, isClientFav])
}

// ==============================================================================
// 6. EQUIPMENT INVENTORY & KIT BUNDLES (BOM)
// ==============================================================================

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  sku          String   @unique
  serialNumber String?
  discipline   String   @default("UNIVERSAL") // PHOTOGRAPHY, VIDEOGRAPHY, UNIVERSAL
  category     String   // Cameras, Lenses, Lighting, Audio, Support
  condition    String   @default("EXCELLENT") // EXCELLENT, GOOD, MAINTENANCE_NEEDED, DAMAGED
  status       String   @default("AVAILABLE") // AVAILABLE, ON_SHOOT, RESERVED, MAINTENANCE
  dailyRate    Float?
  location     String?

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kitBundleItems KitBundleItem[]
  reservations   EquipmentReservation[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, status])
}

model KitBundle {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  description String
  discipline  String          // PHOTOGRAPHY, VIDEOGRAPHY, HYBRID
  dailyRate   Float?

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       KitBundleItem[]

  @@index([tenantId])
}

model KitBundleItem {
  id          String        @id @default(cuid())
  bundleId    String
  itemId      String
  quantity    Int           @default(1)

  bundle      KitBundle     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([bundleId, itemId])
  @@index([bundleId])
  @@index([itemId])
}

model EquipmentReservation {
  id           String        @id @default(cuid())
  projectId    String
  itemId       String
  startDate    DateTime
  endDate      DateTime
  status       String        @default("RESERVED") // RESERVED, CHECKED_OUT, RETURNED

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inspection   InspectionLog?

  @@index([projectId])
  @@index([itemId])
  @@index([itemId, startDate, endDate])
}

model InspectionLog {
  id                String               @id @default(cuid())
  reservationId     String               @unique
  inspectorName     String
  checkoutCondition String
  checkinCondition  String?
  notes             String?
  createdAt         DateTime             @default(now())

  reservation       EquipmentReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ==============================================================================
// 7. INBOUND CLIENT BOOKINGS & SHOWCASE CMS
// ==============================================================================

model ClientBooking {
  id             String       @id @default(cuid())
  tenantId       String
  trackingCode   String       @unique
  category       String       @default("STUDIO_PORTRAIT")
  clientName     String
  clientEmail    String
  clientPhone    String
  discipline     String
  serviceTier    String
  targetDate     String?
  creativeBrief  String?
  status         String       @default("PENDING") // PENDING, CONFIRMED, COMPLETED (shoot done), DELIVERED, NO_SHOW, CANCELLED
  cancelledAt    DateTime?
  cancelReason   String?
  completedAt    DateTime?    // Shoot marked done (or no-show)
  deliveredAt    DateTime?
  deliveryUrl    String?      // Link to the client's gallery or files, shown in their account
  depositPaid    Boolean      @default(false)
  depositAmount  Float        @default(0.0)
  packageId      String?      // Service package the client chose; sets deposit and balance
  packageName    String?      // Snapshot at booking time
  sessionPrice   Float?       // Package price at booking time; balance = sessionPrice - depositAmount
  paymentMethod  String?      // CARD, QR_CODE, CASH
  slotId         String?      @unique
  userId         String?
  createdAt      DateTime     @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot           BookingSlot? @relation(fields: [slotId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])
  package        ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  invoices       MilestoneInvoice[]
  project        Project?
  includedPrints BookingIncludedPrint[]
  assignments    BookingAssignment[]

  @@index([tenantId])
  @@index([userId])
  @@index([slotId])
  @@index([tenantId, status])
}

// A named set of access a studio gives to team members (e.g. "Photographer", "Front desk").
// access is JSON: { areas: { <area>: NONE|OWN|VIEW|MANAGE }, ticks: { <tick>: boolean } }.
model TeamRole {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  access    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// A team member put on a booking (shoot). Gone when the booking is deleted.
model BookingAssignment {
  id           String        @id @default(cuid())
  tenantId     String
  bookingId    String
  userId       String
  assignedById String?
  createdAt    DateTime      @default(now())

  booking      ClientBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([userId])
  @@index([tenantId])
}

model ServicePackage {
  id           String         @id @default(cuid())
  tenantId     String
  category     String         @default("STUDIO_PORTRAIT")
  name         String
  discipline   String
  price        Float
  depositPrice Float          @default(50.0)
  description  String
  deliverables String
  turnaround   String
  isFeatured   Boolean        @default(false)
  /// Switched off: kept with its bookings, but no longer offered for new ones (website, booking, checkout, staff).
  isActive     Boolean        @default(true)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  showcases    ShowcaseItem[]
  bookings     ClientBooking[]
  includedPrints PackageIncludedPrint[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isFeatured])
  @@index([tenantId, isActive])
}

model ShowcaseItem {
  id               String          @id @default(cuid())
  tenantId         String
  category         String          @default("STUDIO_PORTRAIT")
  title            String
  clientName       String
  discipline       String
  coverImageUrl    String
  videoEmbedUrl    String?
  galleryImages    String?         // JSON string array of preview image URLs
  servicePackageId String?
  isFeatured       Boolean         @default(true)
  sortOrder        Int             @default(0)

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id])

  @@index([tenantId])
  @@index([servicePackageId])
  @@index([tenantId, category, sortOrder])
  @@index([tenantId, isFeatured])
}

// ==============================================================================
// WALL ART PRINT ORDERS
// ==============================================================================

model PackageIncludedPrint {
  id            String         @id @default(cuid())
  packageId     String
  printSizeId   String
  frameDesignId String
  quantity      Int

  package       ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model BookingIncludedPrint {
  id            String        @id @default(cuid())
  tenantId      String
  bookingId     String
  printSizeId   String
  frameDesignId String
  quantity      Int
  // Snapshot of the size and frame at the time the print was granted
  sizeCode      String
  sizeName      String
  widthInches   Float
  heightInches  Float
  frameName     String
  source        String        // PACKAGE, BACKFILL, MANUAL
  grantedById   String?
  note          String?
  createdAt     DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking       ClientBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
}

model PrintOrder {
  id               String            @id @default(cuid())
  tenantId         String
  clientId         String
  projectId        String
  orderNumber      String            @unique
  fulfilment       String            // SHIP, PICKUP
  recipientName    String?
  recipientPhone   String?
  line1            String?
  line2            String?
  postcode         String?
  city             String?
  state            String?
  country          String            @default("Malaysia")
  shippingZoneName String?
  shippingFee      Float             @default(0)
  itemsTotal       Float
  totalAmount      Float
  status           String            @default("NEW")
  courier          String?
  trackingNumber   String?
  invoiceId        String?           @unique
  placedById       String
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           User              @relation("PrintOrderClient", fields: [clientId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id])
  invoice          MilestoneInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items            PrintOrderItem[]

  @@index([tenantId])
  @@index([clientId])
  @@index([projectId])
  @@index([tenantId, status])
}

model PrintOrderItem {
  id                     String     @id @default(cuid())
  orderId                String
  kind                   String     // INCLUDED, PAID
  bookingIncludedPrintId String?
  deliverableItemId      String?
  photoUrl               String
  photoTitle             String
  orientation            String
  printSizeId            String
  sizeCode               String
  sizeName               String
  widthInches            Float
  heightInches           Float
  sizePrice              Float
  frameDesignId          String
  frameName              String
  framePrice             Float
  matBoardType           String
  matPrice               Float
  upgradeAmount          Float
  lineAmount             Float

  order                  PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ShippingZone {
  id         String @id @default(cuid())
  tenantId   String
  name       String
  fee        Float
  statesJson String // JSON array of state names
  sortOrder  Int    @default(0)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A studio owner asking the platform owner for an invite (from the public landing page). Not tied to a studio.
model InviteRequest {
  id         String    @id @default(cuid())
  name       String
  studioName String
  email      String
  phone      String?
  kind       String    // PHOTO, VIDEO, BOTH
  message    String?
  createdAt  DateTime  @default(now())
  handledAt  DateTime?

  @@index([createdAt])
  @@index([email])
}
