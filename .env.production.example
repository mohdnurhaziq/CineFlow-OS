# ─── CineFlow OS — PRODUCTION settings ────────────────────────────────────────
# Copy to <CineFlow>/production/.env on the 24/7 PC and fill in the blanks.
# This is the live copy that studios and their clients use. It refuses to start with unsafe
# settings and says which one to fix (docker compose logs app). Never commit the real .env.

# Which copy this is. Keep these three as they are.
COMPOSE_PROJECT_NAME=cineflow-production
COMPOSE_PROFILES=domain,backup
APP_ENV=production

# Where the app listens on the 24/7 PC (the tunnel is how people reach it)
APP_BIND=127.0.0.1
APP_PORT=3200

# The live address: your domain itself. Fixed into the build: change it, then deploy again.
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_APP_DOMAIN=example.com
# Each studio at its own subdomain (lumina-cine.example.com). Fixed into the build.
NEXT_PUBLIC_STUDIO_SUBDOMAINS=true

# Invite code for creating a studio (the beta). Give it to the people you invite; sign-up asks for
# it. Leave empty to close studio sign-up. Changing it only needs: docker compose up -d app
# Make it long and random, not a word, e.g.: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
STUDIO_SIGNUP_CODE=

# Signing secret for sign-ins. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different one from staging, and keep it: changing it signs everyone out.
AUTH_SECRET=

# Cloudflare tunnel token for <domain> and *.<domain> (Zero Trust → Networks → Tunnels)
TUNNEL_TOKEN=

# Real email: SMTP (e.g. Gmail with an app password) or Resend. Production won't start without one.
# Option A: SMTP (Gmail: smtp.gmail.com, port 465, a 16-character app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B: Resend (needs a verified domain). Production will not start with a key but no
# RESEND_FROM_EMAIL: without it Resend only delivers to its account owner, so clients get nothing.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="CineFlow OS <hello@your-domain>"   (an address on your verified domain)

# Payments: live Toyyibpay. Each studio enters its own keys in Admin → Settings.
# Don't set TOYYIBPAY_BASE_URL or ALLOW_SIMULATED_CARD_PAYMENTS here.

# Backups. BACKUP_DIR is relative to this folder; point it inside a Google Drive or
# OneDrive folder to keep a copy off this PC. Finished deliverables can be large.
BACKUP_DIR=../backups
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Email the super-admins when free space on the backup folder's drive or Docker's disk drops below this.
BACKUP_MIN_FREE_GB=5
TZ=Asia/Kuala_Lumpur

# Where the staging folder is, so `deploy production` can take the version staging runs
STAGING_DIR=../staging
